{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "playwright/test"],
    "lib": ["ES2020", "DOM"],
    "baseUrl": "."
  },
  "include": ["tests", "pages", "data-loader"],
  "exclude": ["node_modules", "allure-results", "playwright-report", "test-results"]
}
